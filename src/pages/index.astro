---
import BaseLayout from '../layouts/BaseLayout.astro';
import yaml from 'js-yaml';
import fs from 'node:fs';

const resumeFile = fs.readFileSync('./src/data/resume.yaml', 'utf-8');
const resume = yaml.load(resumeFile) as any;
---
<BaseLayout title={`${resume.basics.name} — ${resume.basics.label}`}>
  <!-- Hero / Header -->
  <header class="hero">
    <h1 class="hero-name">{resume.basics.name}<span class="cursor">_</span></h1>
    <p class="hero-label">{resume.basics.label}</p>
    {resume.basics.summary && <p class="hero-summary">{resume.basics.summary}</p>}
    <div class="hero-links">
      {resume.basics.profiles.map((p: any) => (
        <a href={p.url} target="_blank" rel="noopener">{p.network}</a>
      ))}
      <button class="print-btn" onclick="window.print()" aria-label="Print resume">Print</button>
    </div>
  </header>

  <!-- Skills -->
  <section>
    <h2 class="section-heading">Skills</h2>
    <div class="skills-grid">
      {resume.skills.map((cat: any) => (
        <div class="skill-category">
          <h3 class="skill-name">{cat.name}</h3>
          <div class="skill-tags">
            {cat.keywords.map((kw: string) => <span class="tag">{kw}</span>)}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Experience -->
  <section>
    <h2 class="section-heading">Experience</h2>
    {resume.work.map((job: any) => (
      <div class="entry">
        <div class="entry-header">
          <strong>{job.position}</strong>
          <span class="entry-date">{job.startDate} — {job.endDate || 'Present'}</span>
        </div>
        <p class="entry-sub">{job.company}</p>
        <ul class="entry-highlights">
          {job.highlights.map((h: string) => <li>{h}</li>)}
        </ul>
      </div>
    ))}
  </section>

  <!-- Education -->
  <section>
    <h2 class="section-heading">Education</h2>
    {resume.education.map((edu: any) => (
      <div class="entry">
        <div class="entry-header">
          <strong>{edu.area || edu.institution}</strong>
          {edu.endDate && <span class="entry-date">{edu.endDate}</span>}
        </div>
        <p class="entry-sub">{edu.institution}{edu.location ? ` · ${edu.location}` : ''}</p>
      </div>
    ))}
  </section>
</BaseLayout>

<style>
  .hero {
    margin-bottom: 2.5rem;
  }

  .hero-name {
    font-size: 2rem;
    font-weight: 700;
    line-height: 1.2;
  }

  .cursor {
    color: var(--color-accent);
    animation: blink 1s step-end infinite;
  }

  @keyframes blink {
    50% { opacity: 0; }
  }

  .hero-label {
    color: var(--color-text-muted);
    font-size: 1rem;
    margin-top: 0.25rem;
  }

  .hero-summary {
    color: var(--color-text-muted);
    font-size: 0.875rem;
    margin-top: 0.75rem;
    line-height: 1.5;
  }

  .hero-links {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 1rem;
    font-size: 0.875rem;
  }

  .print-btn {
    background: var(--color-accent);
    border: none;
    border-radius: 0.25rem;
    padding: 0.4rem 0.75rem;
    cursor: pointer;
    color: var(--color-bg);
    font-family: inherit;
    font-size: 0.875rem;
    font-weight: 600;
    margin-left: auto;
  }

  .print-btn:hover {
    background: var(--color-accent-hover);
  }

  section {
    margin-bottom: 2.5rem;
  }

  .entry {
    margin-bottom: 1.5rem;
  }

  .entry-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .entry-date {
    color: var(--color-text-muted);
    font-size: 0.8rem;
  }

  .entry-sub {
    color: var(--color-text-muted);
    font-size: 0.875rem;
    margin-top: 0.125rem;
  }

  .entry-highlights {
    margin-top: 0.5rem;
    padding-left: 1.25rem;
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }

  .entry-highlights li {
    margin-bottom: 0.25rem;
  }

  .skills-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .skill-category {
    flex: 1 1 12rem;
  }

  .skill-name {
    font-size: 0.875rem;
    font-weight: 600;
    margin-bottom: 0.5rem;
  }

  .skill-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }

  .tag {
    background: var(--color-accent-subtle);
    color: var(--color-accent-tag);
    padding: 0.2rem 0.5rem;
    border-radius: 0.25rem;
    font-size: 0.75rem;
  }

  @media print {
    .hero {
      margin-bottom: 0.4rem;
    }

    .hero-name {
      font-size: 1.5rem;
    }

    .hero-label {
      font-size: 0.85rem;
    }

    .hero-summary {
      font-size: 0.8rem;
    }

    .hero-links {
      margin-top: 0.5rem;
      gap: 0.5rem;
      font-size: 0.8rem;
    }

    section {
      margin-bottom: 0.6rem;
    }

    .entry {
      margin-bottom: 0.6rem;
    }

    .entry-header {
      gap: 0.25rem;
      font-size: 0.85rem;
    }

    .entry-date {
      font-size: 0.75rem;
    }

    .entry-sub {
      margin-top: 0;
      font-size: 0.8rem;
    }

    .entry-highlights {
      margin-top: 0.25rem;
      font-size: 0.8rem;
    }

    .entry-highlights li {
      margin-bottom: 0.1rem;
    }

    .skills-grid {
      gap: 0.3rem 1rem;
    }

    .skill-category {
      display: flex;
      align-items: baseline;
      gap: 0.5rem;
      flex: 1 1 100%;
    }

    .skill-name {
      margin-bottom: 0;
      white-space: nowrap;
      font-size: 0.75rem;
    }

    .skill-name::after {
      content: ':';
    }

    .skill-tags {
      gap: 0.25rem;
    }

    .tag {
      padding: 0.1rem 0.35rem;
      font-size: 0.7rem;
      background: none;
      color: var(--color-text);
      border: 1px solid var(--color-surface-border);
    }
  }
</style>
